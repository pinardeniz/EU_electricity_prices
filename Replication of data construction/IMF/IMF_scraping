# Load required library
install.packages("chromote")
library(chromote)
library(rvest)

# Initialize Chromote session
b <- ChromoteSession$new()

download_clean_text <- function(link, session, file_name) {
  # Step 1: Navigate to the page
  session$Page$navigate(link)
  
  # Step 2: Wait for the page to fully load
  Sys.sleep(5)  # Adjust sleep time if the page loads slower
  
  # Step 3: Fetch the HTML content of the page
  page_html <- session$Runtime$evaluate('document.documentElement.outerHTML')$result$value
  
  # Step 4: Parse the HTML and extract clean visible text (remove HTML tags)
  html_content <- read_html(page_html)
  
  # Extract the main content (adjust selector to target specific part of the page)
  # Here, I use "body" to grab the whole visible content, you may refine it for precision.
  page_text <- html_content %>%
    html_elements("body") %>%  # This can be changed to a more specific selector if needed
    html_text(trim = TRUE)     # Extract visible text and trim extra spaces
  
  # Step 5: Clean up text by removing excess white space
  clean_text <- gsub("\\s+", " ", page_text)  # Remove multiple spaces and line breaks
  
  # Step 6: Save the clean text to a .txt file
  writeLines(clean_text, file_name)
}

# Loop through the list of links and download the content as .txt files
for (i in seq_along(link)) {
  # Define the file name for each .txt file (e.g., page1.txt, page2.txt, etc.)
  file_name <- paste0(i, ".txt")
  
  # Download the page content and save it
  download_clean_text(link[i], b, file_name)
  
  # Print a status message to track progress
  cat("Downloaded:", link[i], "as", file_name, "\n")
}
